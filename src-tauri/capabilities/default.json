{
  "$schema": "../gen/schemas/desktop-schema.json",
  "capabilities": [
    {
      "identifier": "default",
      "description": "Capability for the full application windows",
      "windows": ["main", "settings", "stats"],
      "permissions": [
        "core:default",
        "log:default",
        "core:window:allow-close",
        "core:window:allow-minimize",
        "core:webview:allow-create-webview-window",
        "core:window:allow-show",
        "core:window:allow-set-focus",
        "core:window:allow-start-dragging",
        "core:window:allow-start-resize-dragging",
        "core:window:allow-toggle-maximize",
        "core:window:allow-is-maximized",
        "core:window:allow-set-fullscreen",
        "core:window:allow-is-fullscreen",
        "opener:default",
        "dialog:default",
        "dialog:allow-open",
        "notification:allow-is-permission-granted",
        "notification:allow-request-permission",
        "notification:allow-show",
        "notification:allow-notify",
        "updater:default"
      ]
    },
    {
      "identifier": "widget",
      "description": "Capability for the floating clock window",
      "windows": ["widget"],
      "permissions": [
        "core:event:allow-listen",
        "core:event:allow-unlisten",
        "core:window:allow-start-dragging",
        "log:default"
      ]
    },
    {
      "identifier": "tray-panel",
      "description": "Capability for the transient Windows tray panel",
      "platforms": ["windows"],
      "windows": ["tray-panel-*"],
      "permissions": ["core:event:allow-listen", "core:event:allow-unlisten", "log:default"]
    }
  ]
}
